{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build:web:server",
  "outputDirectory": ".next",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/flutterwave/webhook", "destination": "/api/flutterwave/webhook/" },
    { "source": "/api/flutterwave/create-checkout", "destination": "/api/flutterwave/create-checkout/" },
    { "source": "/api/flutterwave/verify-payment", "destination": "/api/flutterwave/verify-payment/" },
    { "source": "/api/subscription/status", "destination": "/api/subscription/status/" },
    { "source": "/api/pricing", "destination": "/api/pricing/" }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.mjs",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    },
    {
      "source": "/(.*)\\.geojson",
      "headers": [{ "key": "Content-Type", "value": "application/geo+json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
